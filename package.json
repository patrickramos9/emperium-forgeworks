{
  "name": "emperium-forgeworks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "check:storage": "tsx scripts/check-storage-outputs.ts",
    "build": "npm run check:storage && tsc -b && vite build",
    "build:vite": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "seed": "tsx scripts/seed-products.ts",
    "grant:ga4-access": "tsx scripts/grant-ga4-service-account-access.ts",
    "sandbox": "npx ampx sandbox --profile default"
  },
  "dependencies": {
    "@emperium/shared": "*",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "aws-amplify": "^6.12.0",
    "dompurify": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.14.0",
    "@aws-amplify/backend-cli": "^1.4.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "google-auth-library": "^10.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
